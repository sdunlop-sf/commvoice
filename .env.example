# Copy this file to .env and paste your key (no quotes, one line).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional overrides (see README):
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_VERIFY_MODEL=gemini-flash-latest
# VERIFY_WITH_MODEL=1
# ALLOW_GENERAL_TERMS=1
# ASK_LIMIT_PER_MIN=60
# MAX_UPLOAD_MB=15
