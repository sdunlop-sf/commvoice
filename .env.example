# Copy this file to .env and paste your key (no quotes, one line).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional overrides (see README):
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_VERIFY_MODEL=gemini-flash-latest
# VERIFY_WITH_MODEL=1
# ALLOW_GENERAL_TERMS=1
# ASK_LIMIT_PER_MIN=60
# MAX_UPLOAD_MB=15

# Optional: ElevenLabs voice. One key covers voice in (speech to text) and voice out (text to speech).
# Without it the app uses the browser's own voice features (Chrome, Edge and Safari can listen; every browser can read aloud).
# Get a key at https://elevenlabs.io (profile menu > API keys). Pick a voice under Voices and copy its ID.
# ELEVENLABS_API_KEY=your-key-here
# ELEVENLABS_VOICE_ID=IKne3meq5aSn9XLyUdCD
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

# If gemini-flash-latest is "experiencing high demand", pin a model that answers (python test_model.py --list shows them):
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_VERIFY_MODEL=gemini-3.5-flash-lite
